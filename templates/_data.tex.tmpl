% =============== DECIMAL SEPARATOR ===============
% CommaDecimal selects the decimal mark for amount DISPLAY: comma (German,
% default for EUR) vs dot. \fmtmoney is a display-only transform — FP arithmetic
% and the EPC QR keep the raw dot value. Designs opt in by wrapping amounts in
% \fmtmoney{...}; designs that don't are unaffected.
\newif\ifCommaDecimal
{{if .CommaDecimal}}\CommaDecimaltrue{{else}}\CommaDecimalfalse{{end}}
\makeatletter
\newcount\fm@cnt
% Locale marks: comma mode (German) -> "." thousands, "," decimal;
% dot mode (English) -> "," thousands, "." decimal.
\ifCommaDecimal\def\fm@thou{.}\def\fm@dec{,}\else\def\fm@thou{,}\def\fm@dec{.}\fi
% \fmtmoney{<dot-decimal>}: display-only — strips surrounding spaces, groups the
% integer part into thousands, and localises the decimal mark. FP arithmetic and
% the EPC QR keep the raw dot value; designs opt in by wrapping amount sites.
% Handles a leading '-' and integers without a fractional part.
\def\fmtmoney#1{%
  \edef\fm@x{\zap@space#1 \@empty}%
  \expandafter\fm@parse\fm@x..\fm@stop}
\def\fm@parse#1.#2.#3\fm@stop{\fm@sign#1\fm@e{#2}}
\def\fm@sign#1#2\fm@e#3{%
  \if-#1\relax-\fm@emit{#2}{#3}\else\fm@emit{#1#2}{#3}\fi}
\def\fm@emit#1#2{%
  \fm@grpint{#1}\if\relax\detokenize{#2}\relax\else\fm@dec#2\fi}
% Group an integer digit string: reverse, insert \fm@thou every 3, reverse back.
\def\fm@grpint#1{%
  \def\fm@A{}\fm@revA#1\fm@stop
  \fm@cnt=0 \def\fm@B{}\expandafter\fm@grpB\fm@A\fm@stop
  \def\fm@C{}\expandafter\fm@revC\fm@B\fm@stop
  \fm@C}
\def\fm@revA#1{\ifx\fm@stop#1\else\edef\fm@A{#1\fm@A}\expandafter\fm@revA\fi}
\def\fm@grpB#1{\ifx\fm@stop#1\else
  \advance\fm@cnt1
  \ifnum\fm@cnt>3 \edef\fm@B{\fm@B\fm@thou}\fm@cnt=1 \fi
  \edef\fm@B{\fm@B#1}\expandafter\fm@grpB\fi}
\def\fm@revC#1{\ifx\fm@stop#1\else\edef\fm@C{#1\fm@C}\expandafter\fm@revC\fi}
\makeatother
% =============== DECIMAL SEPARATOR ===============


